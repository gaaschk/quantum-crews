<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.quantumhorizon.quantum-crews</string>
<key>ProgramArguments</key><array>
<string>/opt/homebrew/bin/python3</string><string>DEPLOY_ROOT/manage.py</string>
<string>once</string><string>--root</string><string>DEPLOY_ROOT</string>
<string>--repo</string><string>GITHUB_OWNER/quantum-crews</string>
</array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>60</integer>
<key>StandardOutPath</key><string>DEPLOY_ROOT/deploy.log</string>
<key>StandardErrorPath</key><string>DEPLOY_ROOT/deploy.err</string>
</dict></plist>
