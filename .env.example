# Gateway settings. Export these in the startup shell; npm run dev does not load .env files.
# Live execution stays disabled unless QUANTUM_ALLOW_LIVE=true is explicitly exported.
# Do not copy credentials from other projects.
SMART_ROUTER_BASE_URL=https://smart-router.kevingaasch.com
SMART_ROUTER_API_KEY=
SMART_ROUTER_PLANNER_MODEL=smart-orchestrator
SMART_ROUTER_WORKER_MODEL=smart-worker
